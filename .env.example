# Copy to .env and fill in. Never commit the real .env file.

# --- Required in production (DJANGO_DEBUG=false) ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=wardrobe.example.com
# Needed for form posts when served over https on your domain
DJANGO_CSRF_TRUSTED_ORIGINS=https://wardrobe.example.com

# --- Local development ---
# DJANGO_DEBUG=true needs no secret key or hosts.
DJANGO_DEBUG=false

# --- HTTPS (defaults to on whenever DJANGO_DEBUG=false) ---
# Set to false only for plain-HTTP local runs of the production setup.
# DJANGO_SECURE_SSL=false
# Set to true only behind a reverse proxy that sets X-Forwarded-Proto.
# DJANGO_TRUST_PROXY_HEADERS=true

# --- Storage (optional) ---
# DATABASE_URL=postgres://user:password@host:5432/wardrobe   # default: SQLite file in the project dir
# MEDIA_ROOT=/data/media

# --- App tuning (optional) ---
# MAX_UPLOAD_MB=5
# CONFIDENCE_THRESHOLD=0.5
# LOG_LEVEL=INFO
# WEB_CONCURRENCY=1      # gunicorn workers (each loads its own copy of the model)
# GUNICORN_THREADS=4
# PORT=8000
